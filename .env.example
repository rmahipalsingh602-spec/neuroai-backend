# Copy this file to `.env` and replace the placeholder values.
APP_NAME=NeuroAI Pro
DATABASE_URL=sqlite:///./neuroai.db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
FREE_MONTHLY_QUERIES=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https://.*$
UPLOADS_PATH=./uploads
VOICE_TEMP_PATH=./uploads/voice-temp

# Configure at least one AI provider key for live chat responses.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Groq (preferred fallback if configured)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Razorpay
RAZORPAY_KEY_ID=rzp_test_S6VEtiLAm2t47k
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_PLAN_AMOUNT=19900
RAZORPAY_CURRENCY=INR

# Optional: comma-separated admin emails
ADMIN_EMAILS=rmahipalsingh602@gmail.com
